# AI Service / Agent keys
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# (Optional) Separate Google API key — only needed if different from GEMINI_API_KEY
# GOOGLE_API_KEY=your_google_api_key_here

# Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/promeet

# JWT security — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_jwt_secret_key_here

# Backend-to-agent internal communication
API_BASE_URL=http://localhost:8000/api
API_BEARER_TOKEN=your_internal_bearer_token_here

# Third-party integrations
TAVILY_API_KEY=your_tavily_api_key_here
UNSTRUCTURED_API_KEY=your_unstructured_api_key_here

# Notion integration (optional)
NOTION_TOKEN=your_notion_integration_token
NOTION_DATABASE_ID=your_notion_database_id

# Email notifications (Gmail App Password recommended)
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password_here

# Flask-SocketIO (ggmeeting service)
FLASK_SECRET_KEY=your_flask_secret_key_here
